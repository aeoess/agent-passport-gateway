# AEOESS Gateway — Environment Variables
# Copy to .env and fill in values

# Server
PORT=3200
DB_PATH=/data/gateway.db      # Use /data/ for Railway Volume
CORS_ORIGIN=*                  # Set to specific origin in production
NODE_ENV=production

# Stripe (for billing — optional for MVP)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# JWT (for future dashboard auth)
# JWT_SECRET=your-secret-here
