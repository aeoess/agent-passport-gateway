# Agent Passport Gateway environment variables
# Copy to .env and fill in values

# Server
PORT=3200
DB_PATH=/data/gateway.db
CORS_ORIGIN=*                  # Set to specific origin in production
NODE_ENV=production

# Operator identity (optional, unset means nobody is elevated to admin)
# GATEWAY_OPERATOR_EMAIL=you@example.com
# GATEWAY_OPERATOR_EMAIL_ALIASES=support@example.com,ops@example.com

# Stripe (for billing — optional for MVP)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# JWT (for future dashboard auth)
# JWT_SECRET=your-secret-here

# Nano Payment Rail
# NANO_RECEIVING_ADDRESS=nano_3pp4166...  # Gateway receiving address
# NANO_RPC_URL=https://rpc.nano.to               # Public node for reads
# NANO_SEND_RPC_URL=                     # Wallet-enabled node for sends (optional)
# NANO_WALLET_ID=                        # Wallet ID on send node (optional)
# NANO_SENDING_ADDRESS=                  # Source account for outbound (optional)

# Agent Wallets (requires wallet-enabled Nano node)
# NANO_WALLET_RPC_URL=                   # Wallet-enabled node for wallet ops
# NANO_WALLET_ID=                        # Master wallet ID on the node
