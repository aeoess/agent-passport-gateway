# AEOESS Gateway — Environment Variables
# Copy to .env and fill in values

# Server
PORT=3200
DB_PATH=/data/gateway.db      # Use /data/ for Railway Volume
CORS_ORIGIN=*                  # Set to specific origin in production
NODE_ENV=production

# Stripe (for billing — optional for MVP)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# JWT (for future dashboard auth)
# JWT_SECRET=your-secret-here

# Nano Payment Rail
# NANO_RECEIVING_ADDRESS=nano_3pp4166...  # Gateway receiving address
# NANO_RPC_URL=https://rpc.nano.to               # Public node for reads
# NANO_SEND_RPC_URL=                     # Wallet-enabled node for sends (optional)
# NANO_WALLET_ID=                        # Wallet ID on send node (optional)
# NANO_SENDING_ADDRESS=                  # Source account for outbound (optional)
