# In-tenant deployment environment (G-D4). Copy to .env and edit.
# This is the in-tenant/air-gapped path. The repository-root .env.example is
# the hosted Railway single-tenant path; keep the two separate.

# HTTP port the gateway listens on.
PORT=3200

# Customer-owned data volume. The gateway stores only hashes and pointers
# here, never PHI or raw sensitive payloads.
DB_PATH=/data/gateway.db

# ── D2 isolation switch ──
# 'hard'     = regulated tenant, no cross-tenant path (default-safe).
# 'standard' = may opt in to de-identified, aggregated, above-k-floor signal.
ISOLATION_MODE=hard

# ── Customer bring-your-own trust root (W2-B1) ──
# 'gateway' = DB-generated key (NOT for regulated tenants).
# 'hsm'     = customer HSM-resident key.
# 'kms'     = customer KMS-resident key.
TRUST_ROOT_SOURCE=gateway

# Opaque reference to the customer HSM/KMS key. NEVER the private key.
# HSM example: pkcs11:slot=0;object=tenant-signer
# KMS example: arn:aws:kms:us-east-1:111122223333:key/abcd-1234-...
TRUST_ROOT_KEY_REF=

NODE_ENV=production
